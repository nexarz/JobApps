datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  documents    Document[]
  applications Application[]
}

model Document {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String
  company   String?
  role      String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Application {
  id          String   @id @default(cuid())
  jobTitle    String
  company     String
  jobUrl      String?
  jobDesc     String
  coverLetter String
  resume      String
  websiteHtml String
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}
